{
  "name": "@agentglass/worker",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./coordinator": "./src/coordinator.ts",
    "./main": "./src/main.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/main.js --external:@agentglass/*"
  },
  "dependencies": {
    "@agentglass/a2a": "workspace:*",
    "@agentglass/code-lab": "workspace:*",
    "@agentglass/context": "workspace:*",
    "@agentglass/contracts": "workspace:*",
    "@agentglass/conversation": "workspace:*",
    "@agentglass/db": "workspace:*",
    "@agentglass/events": "workspace:*",
    "@agentglass/evolution": "workspace:*",
    "@agentglass/harness": "workspace:*",
    "@agentglass/knowledge": "workspace:*",
    "@agentglass/learner-runtime": "workspace:*",
    "@agentglass/lessons": "workspace:*",
    "@agentglass/mcp": "workspace:*",
    "@agentglass/policy": "workspace:*",
    "@agentglass/provider-gateway": "workspace:*",
    "@agentglass/runtime-reference": "workspace:*",
    "@agentglass/source-map": "workspace:*",
    "@agentglass/tools": "workspace:*",
    "esbuild": "^0.25.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
