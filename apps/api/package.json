{
  "name": "@agentglass/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:@agentglass/* --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@agentglass/code-lab": "workspace:*",
    "@agentglass/contracts": "workspace:*",
    "@agentglass/conversation": "workspace:*",
    "@agentglass/db": "workspace:*",
    "@agentglass/events": "workspace:*",
    "@agentglass/knowledge": "workspace:*",
    "@agentglass/learner-runtime": "workspace:*",
    "@agentglass/lessons": "workspace:*",
    "@agentglass/policy": "workspace:*",
    "@agentglass/projections": "workspace:*",
    "@agentglass/provider-gateway": "workspace:*",
    "@agentglass/replay": "workspace:*",
    "@agentglass/runtime-reference": "workspace:*",
    "@agentglass/source-map": "workspace:*",
    "@agentglass/tools": "workspace:*",
    "@agentglass/worker": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0"
  }
}
